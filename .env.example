# NeonDB (PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/blog?sslmode=require"

# Better-Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# アプリ層暗号化(Discord Webhook URL等) — openssl rand -base64 32
ENCRYPTION_KEY=""

# Upstash Redis (レート制限)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend (一括メール送信)
RESEND_API_KEY=""

# S3互換オブジェクトストレージ (Cloudflare R2 / 自前RustFS等。CORSでこのアプリのオリジンからのGET/PUTを許可すること)
S3_ENDPOINT="https://storage.example.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="blog-uploads"
